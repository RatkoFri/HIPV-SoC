TOPLEVEL_DIR := $(abspath ../../..)

# Memory image applied at elaboration through INIT_FILE, exactly as a
# synthesis flow would supply it. Regenerated by gen_init.py if missing.
INIT_FILE ?= $(PWD)/mem_init.hex

TOPLEVEL = obi_ram
MODULE   = test_obi_ram
VERILOG_SOURCES = $(TOPLEVEL_DIR)/rtl/mem/sync_dual_port_RAM.sv \
                  $(TOPLEVEL_DIR)/rtl/mem/obi_ram_port.sv \
                  $(TOPLEVEL_DIR)/rtl/mem/obi_ram.sv

# small memory keeps the build fast: 256 words = 1 KiB
COMPILE_ARGS += -GADDR_WIDTH=8 -GINIT_FILE=\"$(INIT_FILE)\"

include $(TOPLEVEL_DIR)/tb/common/Makefile.include

# rules after the include so that cocotb's `all` stays the default goal
$(INIT_FILE): gen_init.py
	python3 gen_init.py $@

$(SIM_BUILD)/Vtop.mk: $(INIT_FILE)

clean::
	@rm -f $(INIT_FILE)
